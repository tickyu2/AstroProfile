# ============================================
# GENESIS Frontend Environment Configuration
# ============================================
# Copy this file to .env and update values

# API Configuration
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/api/dashboard/stream

# For production, update to:
# VITE_API_URL=https://your-backend-domain.com
# VITE_WS_URL=wss://your-backend-domain.com/api/dashboard/stream

# Firebase Configuration (if using)
# VITE_FIREBASE_API_KEY=your-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# VITE_FIREBASE_APP_ID=your-app-id

# Feature Flags
VITE_GENESIS_ENABLED=true
VITE_DASHBOARD_ENABLED=true
