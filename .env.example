# ============================================
# GENESIS Frontend Environment Configuration
# ============================================
# Copy this file to .env and update values

# API Configuration
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/api/dashboard/stream

# For production, update to:
# VITE_API_URL=https://your-backend-domain.com
# VITE_WS_URL=wss://your-backend-domain.com/api/dashboard/stream

# Firebase Configuration (if using)
# VITE_FIREBASE_API_KEY=your-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# VITE_FIREBASE_APP_ID=your-app-id

# Python Cloud Functions URLs (Swiss Ephemeris - Production)
# These are deployed to Cloud Run and are used automatically by sovereignChartService
# VITE_PYTHON_CHART_URL=https://calculate-natal-chart-sjpjwnbsmq-uc.a.run.app
# VITE_PYTHON_HEALTH_URL=https://python-health-sjpjwnbsmq-uc.a.run.app
# VITE_PYTHON_SYNASTRY_URL=https://calculate-synastry-sjpjwnbsmq-uc.a.run.app
# VITE_PYTHON_SOUL_FAMILY_URL=https://find-soul-family-sjpjwnbsmq-uc.a.run.app

# For local Python development (optional)
# VITE_PYTHON_FUNCTIONS_URL=http://localhost:5001/astroprofile-391e6/us-central1

# Neo4j Aura Agent (Soul Family Discovery)
# Get credentials from Neo4j Aura Console > User Profile > API Keys
# See: https://neo4j.com/developer/genai-ecosystem/aura-agent/#_api_usage
# VITE_NEO4J_AGENT_URL=https://api.neo4j.io/v2beta1/projects/YOUR_PROJECT_ID/agents/YOUR_AGENT_ID/invoke
# VITE_NEO4J_CLIENT_ID=your-neo4j-client-id
# VITE_NEO4J_CLIENT_SECRET=your-neo4j-client-secret

# Feature Flags
VITE_GENESIS_ENABLED=true
VITE_DASHBOARD_ENABLED=true
VITE_SOUL_FAMILY_ENABLED=true

# ============================================
# Backend / Cloud Functions Environment
# ============================================
# These are set in functions/.env or via firebase functions:config:set

# Claude API (for Guest Chat, Luna Coaching)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (for Embeddings in RAG)
# OPENAI_API_KEY=sk-...

# PostgreSQL / Cloud SQL (for RAG vector search)
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/genesis
# Or for Cloud SQL with socket:
# DATABASE_URL=postgresql://postgres:PASSWORD@/genesis?host=/cloudsql/PROJECT:REGION:INSTANCE

# Neo4j Aura (for GraphRAG + Soul Family)
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password

# Google Cloud Project (for Cloud SQL)
# CLOUD_SQL_CONNECTION_NAME=project-id:us-central1:genesis-luna-db
