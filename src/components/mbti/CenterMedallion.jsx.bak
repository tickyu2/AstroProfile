/**
 * CenterMedallion.jsx
 * The Glowing Soul at the Center of the Rose Window
 *
 * Built with SOUL for the cathedral of souls
 * Inspired by Notre-Dame's central medallions
 * Pulsing with divine light and sacred geometry
 */

import React from 'react';
import { motion } from 'framer-motion';

export default function CenterMedallion({ mbtiType, onClick }) {
  // MBTI type info
  const typeInfo = {
    code: mbtiType || '????',
    description: mbtiType ? 'Your Soul Type' : 'Complete 6 Questions'
  };

  return (
    <motion.div
      className="relative flex items-center justify-center"
      style={{ width: '200px', height: '200px' }}
      initial={{ scale: 0, opacity: 0 }}
      animate={{ scale: 1, opacity: 1 }}
      transition={{ delay: 0.3, duration: 0.8, type: "spring" }}
    >
      {/* Outer Glow Ring - Pulsing */}
      <motion.div
        className="absolute inset-0 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 opacity-30 blur-2xl"
        animate={{
          scale: [1, 1.3, 1],
          opacity: [0.3, 0.5, 0.3]
        }}
        transition={{
          duration: 3,
          repeat: Infinity,
          ease: "easeInOut"
        }}
      />

      {/* Middle Ring - Rotating Light Rays */}
      <motion.div
        className="absolute inset-4 rounded-full"
        style={{
          background: 'conic-gradient(from 0deg, transparent 0%, rgba(168, 85, 247, 0.4) 10%, transparent 20%, rgba(236, 72, 153, 0.4) 30%, transparent 40%, rgba(168, 85, 247, 0.4) 50%, transparent 60%, rgba(236, 72, 153, 0.4) 70%, transparent 80%, rgba(168, 85, 247, 0.4) 90%, transparent 100%)'
        }}
        animate={{
          rotate: 360
        }}
        transition={{
          duration: 20,
          repeat: Infinity,
          ease: "linear"
        }}
      />

      {/* Inner Circle - Glass Effect with 3D DEPTH (Session 5.5) */}
      <motion.div
        className="absolute inset-8 rounded-full bg-gradient-to-br from-slate-800/90 to-slate-900/90 backdrop-blur-xl border-2 border-purple-400/50
          shadow-[0_12px_32px_rgba(0,0,0,0.7),0_6px_16px_rgba(124,58,237,0.4),0_0_40px_rgba(168,85,247,0.25),inset_0_1px_0_rgba(255,255,255,0.1)]
          hover:shadow-[0_20px_48px_rgba(0,0,0,0.8),0_10px_24px_rgba(168,85,247,0.5),0_0_60px_rgba(168,85,247,0.4),inset_0_1px_0_rgba(255,255,255,0.15)]"
        whileHover={{ scale: 1.08, y: -4 }}
        transition={{ type: "spring", stiffness: 300 }}
      >
        {/* Inner Glow */}
        <div className="absolute inset-0 rounded-full bg-gradient-to-br from-purple-500/20 to-pink-500/20" />

        {/* Content */}
        <button
          onClick={onClick}
          className="relative w-full h-full flex flex-col items-center justify-center gap-2 rounded-full focus:outline-none focus:ring-2 focus:ring-purple-400 transition-all"
        >
          {/* MBTI Type Code */}
          <motion.div
            className="text-3xl font-bold bg-gradient-to-br from-purple-200 to-pink-200 bg-clip-text text-transparent"
            animate={{
              scale: [1, 1.05, 1]
            }}
            transition={{
              duration: 2,
              repeat: Infinity,
              ease: "easeInOut"
            }}
          >
            {typeInfo.code}
          </motion.div>

          {/* Description */}
          <div className="text-xs text-purple-300 font-medium px-4 text-center">
            {typeInfo.description}
          </div>

          {/* Soul Icon */}
          <motion.div
            className="text-2xl"
            animate={{
              rotate: [0, 10, -10, 0]
            }}
            transition={{
              duration: 4,
              repeat: Infinity,
              ease: "easeInOut"
            }}
          >
            💜
          </motion.div>
        </button>
      </motion.div>

      {/* Sparkles - Floating particles */}
      {[...Array(8)].map((_, i) => {
        const angle = (i / 8) * 360;
        const distance = 100;
        const x = Math.cos((angle * Math.PI) / 180) * distance;
        const y = Math.sin((angle * Math.PI) / 180) * distance;

        return (
          <motion.div
            key={i}
            className="absolute w-1 h-1 bg-purple-400 rounded-full"
            style={{
              left: '50%',
              top: '50%'
            }}
            animate={{
              x: [0, x, 0],
              y: [0, y, 0],
              opacity: [0, 1, 0],
              scale: [0, 1, 0]
            }}
            transition={{
              duration: 3,
              repeat: Infinity,
              delay: i * 0.3,
              ease: "easeInOut"
            }}
          />
        );
      })}
    </motion.div>
  );
}
