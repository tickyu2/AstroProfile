      "name": "The Achiever",
      "alias": ["Performer", "Motivator"],
      "coreFear": "Being worthless, without value apart from achievements",
      "coreDesire": "To be valuable, successful, and admired",
      "coreMotivation": "To be affirmed, to distinguish themselves, to be admired, to impress others",
      "keyStrengths": ["Adaptable", "Ambitious", "Energetic", "Efficient", "Confident"],
      "keyWeaknesses": ["Image-conscious", "Workaholic", "Deceptive", "Competitive", "Emotionally detached"],
      "basicFear": "Of being worthless",
      "basicDesire": "To feel valuable and worthwhile",
      "superego": "I am good or okay if I am successful and others think well of me",

      "wings": {
        "2": {
          "name": "3w2 - The Charmer",
          "traits": ["More personable", "Helpful", "Warm", "Socially skilled"],
          "focus": "Winning people over, relationship-focused success"
        },
        "4": {
          "name": "3w4 - The Professional",
          "traits": ["More introspective", "Artistic", "Emotionally aware", "Intense"],
          "focus": "Authentic achievement, creative excellence"
        }
      },

      "growthPath": {
        "direction": 6,
        "description": "Develop commitment to others and causes beyond self",
        "healthy": "Become cooperative, loyal, authentic"
      },
      "stressPath": {
        "direction": 9,
        "description": "Become disengaged, apathetic, and passive",
        "unhealthy": "Numb out, lose motivation, become stubborn"
      },

      "communicationStyle": {
        "prefers": ["Efficiency", "Recognition", "Goal-oriented talk"],
        "avoids": ["Failure", "Being seen as incompetent", "Lengthy emotional processing"],
        "tips": ["Acknowledge their achievements", "Be efficient", "Focus on outcomes"]
