    "5": {
      "name": "The Investigator",
      "alias": ["Observer", "Thinker"],
      "coreFear": "Being useless, helpless, or incapable",
      "coreDesire": "To be competent, capable, and knowledgeable",
      "coreMotivation": "To possess knowledge, to understand the environment, to have everything figured out",
      "keyStrengths": ["Perceptive", "Innovative", "Curious", "Objective", "Independent"],
      "keyWeaknesses": ["Withdrawn", "Cynical", "Stingy", "Detached", "Isolated"],
      "basicFear": "Of being useless, helpless, or incapable",
      "basicDesire": "To be capable and competent",
      "superego": "I am good or okay if I have mastered something",

      "wings": {
        "4": {
          "name": "5w4 - The Iconoclast",
          "traits": ["More creative", "Emotional", "Sensitive", "Unconventional"],
