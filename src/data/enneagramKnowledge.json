      "lunaGuidance": {
        "approach": "Honor their depth while gently grounding them in present reality",
        "avoid": "Being superficial or dismissing their emotional experience",
        "keyPhrases": ["Your depth is a gift", "What's here right now?", "You belong here"]
      }
