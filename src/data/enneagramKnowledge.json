      "communicationStyle": {
        "prefers": ["Emotional depth", "Authenticity", "Creative expression"],
        "avoids": ["Superficiality", "Being ordinary", "Dismissal of feelings"],
        "tips": ["Validate their uniqueness", "Allow emotional expression", "Be genuine"]
