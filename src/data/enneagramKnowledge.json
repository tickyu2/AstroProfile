      "coreDesire": "To be satisfied, content, and have their needs fulfilled",
      "coreMotivation": "To maintain freedom and happiness, to avoid pain, to keep themselves excited",
      "keyStrengths": ["Optimistic", "Versatile", "Spontaneous", "Playful", "Quick-thinking"],
      "keyWeaknesses": ["Scattered", "Impulsive", "Escapist", "Self-centered", "Undisciplined"],
