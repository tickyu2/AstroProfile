      "keyStrengths": ["Easygoing", "Patient", "Supportive", "Accepting", "Peaceful"],
      "keyWeaknesses": ["Passive", "Complacent", "Stubborn", "Conflict-avoidant", "Self-forgetting"],
      "basicFear": "Of loss and separation",
      "basicDesire": "To have inner stability and peace of mind",
      "superego": "I am good or okay if those around me are good or okay",

      "wings": {
        "8": {
          "name": "9w8 - The Referee",
