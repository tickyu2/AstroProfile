{
  "version": "1.0",
  "description": "Enneagram knowledge base for GENESIS RAG system",
  "created": "2024-12-28",

  "types": {
    "1": {
      "name": "The Reformer",
      "alias": ["Perfectionist", "Improver"],
      "coreFear": "Being corrupt, evil, or defective",
      "coreDesire": "To be good, ethical, balanced, and have integrity",
      "coreMotivation": "To be right, to strive higher and improve everything, to be consistent with ideals",
      "keyStrengths": ["Principled", "Purposeful", "Self-controlled", "Ethical", "Reliable"],
      "keyWeaknesses": ["Critical", "Resentful", "Rigid", "Self-righteous", "Perfectionistic"],
      "basicFear": "Of being bad, corrupt, evil, or defective",
      "basicDesire": "To have integrity and be good",
      "superego": "I am good or okay if I do what is right",

      "wings": {
        "9": {
          "name": "1w9 - The Idealist",
          "traits": ["More introverted", "Philosophical", "Detached", "Calm reformer"],
          "focus": "Internal standards over external action"
        },
        "2": {
          "name": "1w2 - The Advocate",
          "traits": ["More extroverted", "Warm", "Helpful", "Action-oriented"],
          "focus": "Helping others improve and do better"
        }
      },

      "growthPath": {
        "direction": 7,
        "description": "Move toward spontaneity, joy, and acceptance of imperfection",
        "healthy": "Become more relaxed, productive, and joyful"
      },
      "stressPath": {
        "direction": 4,
        "description": "Become moody, irrational, and self-pitying",
        "unhealthy": "Feel exempt from rules, melodramatic"
      },

      "communicationStyle": {
        "prefers": ["Direct feedback", "Logical discussions", "Clear expectations"],
        "avoids": ["Emotional manipulation", "Dishonesty", "Irresponsibility"],
        "tips": ["Acknowledge their efforts", "Be precise", "Show respect for their standards"]
      },

      "lunaGuidance": {
        "approach": "Validate their desire for improvement while gently encouraging self-compassion",
        "avoid": "Being dismissive of their standards or too casual about ethics",
        "keyPhrases": ["Your standards matter", "It's okay to rest", "Progress over perfection"]
      }
    },

    "2": {
      "name": "The Helper",
      "alias": ["Giver", "Caretaker"],
      "coreFear": "Being unwanted, unworthy of love",
      "coreDesire": "To be loved, needed, and appreciated",
      "coreMotivation": "To be loved, to express feelings for others, to be needed and appreciated",
      "keyStrengths": ["Caring", "Generous", "Warm", "Empathetic", "Supportive"],
      "keyWeaknesses": ["Possessive", "People-pleasing", "Manipulative", "Martyrdom", "Intrusive"],
      "basicFear": "Of being unwanted, unworthy of being loved",
      "basicDesire": "To feel loved",
      "superego": "I am good or okay if I am loved by others and am close to them",

      "wings": {
        "1": {
          "name": "2w1 - The Servant",
          "traits": ["More principled", "Objective", "Critical", "Self-sacrificing"],
          "focus": "Helping in 'correct' ways, moral service"
        },
        "3": {
          "name": "2w3 - The Host/Hostess",
          "traits": ["More ambitious", "Image-conscious", "Charming", "Energetic"],
          "focus": "Being liked and successful through helping"
        }
      },

      "growthPath": {
        "direction": 4,
        "description": "Discover their own needs and emotional depth",
        "healthy": "Become self-nurturing, emotionally honest, creative"
      },
      "stressPath": {
        "direction": 8,
        "description": "Become aggressive, dominating, and demanding",
        "unhealthy": "Become controlling, confrontational"
      },

      "communicationStyle": {
        "prefers": ["Personal connection", "Appreciation", "Emotional sharing"],
        "avoids": ["Being ignored", "Rejection", "Cold logic without feeling"],
        "tips": ["Express gratitude", "Ask about their needs", "Be warm and personal"]
      },

      "lunaGuidance": {
        "approach": "Help them recognize their own needs while honoring their giving nature",
        "avoid": "Making them feel their care isn't valued",
        "keyPhrases": ["What do YOU need?", "Your feelings matter too", "It's okay to receive"]
      }
    },

