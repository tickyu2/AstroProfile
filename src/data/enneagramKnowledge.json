      "lunaGuidance": {
        "approach": "Help them connect with authentic feelings beyond achievements",
        "avoid": "Dismissing their accomplishments or being inefficient",
        "keyPhrases": ["You ARE valuable", "Who are you beyond success?", "Feel what's underneath"]
      }
    },

    "4": {
      "name": "The Individualist",
      "alias": ["Romantic", "Artist"],
      "coreFear": "Having no identity or personal significance",
      "coreDesire": "To be unique, special, and authentically themselves",
      "coreMotivation": "To express themselves and their individuality, to find the ideal partner, to withdraw to protect feelings",
      "keyStrengths": ["Creative", "Intuitive", "Emotionally deep", "Authentic", "Compassionate"],
      "keyWeaknesses": ["Self-absorbed", "Melancholic", "Envious", "Dramatic", "Temperamental"],
      "basicFear": "Of having no identity or personal significance",
      "basicDesire": "To find themselves and their significance",
      "superego": "I am good or okay if I am true to myself",

      "wings": {
        "3": {
          "name": "4w3 - The Aristocrat",
          "traits": ["More ambitious", "Image-conscious", "Energetic", "Competitive"],
          "focus": "Standing out through achievement and style"
        },
        "5": {
          "name": "4w5 - The Bohemian",
          "traits": ["More withdrawn", "Intellectual", "Original", "Eccentric"],
          "focus": "Deep inner world, unconventional creativity"
