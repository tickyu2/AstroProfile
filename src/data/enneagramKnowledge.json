      "keyStrengths": ["Loyal", "Responsible", "Hardworking", "Trustworthy", "Courageous"],
      "keyWeaknesses": ["Anxious", "Suspicious", "Indecisive", "Reactive", "Defensive"],
      "basicFear": "Of being without support and guidance",
      "basicDesire": "To have security and support",
      "superego": "I am good or okay if I do what is expected of me",

      "wings": {
        "5": {
          "name": "6w5 - The Defender",
