// 60-YEAR CYCLE DATA (when each combination occurs)
export const sixtyYearCycle = {
  Rabbit: {
    Metal: [1951, 2011, 2071],
    Water: [1963, 2023, 2083],
    Wood: [1975, 2035, 2095],
    Fire: [1987, 2047, 2107],
    Earth: [1999, 2059, 2119]
  },
  Dragon: {
    Metal: [1940, 2000, 2060],
    Water: [1952, 2012, 2072],
    Wood: [1964, 2024, 2084],
    Fire: [1976, 2036, 2096],
    Earth: [1988, 2048, 2108]
  },
  // Add remaining animals as needed...
}

// HELPER: Get complete profile for a specific animal/element combination
export function getZodiacProfile(animal, element) {
  const base = animalBaseTraits[animal]
  const elementData = elementEnhancements[element]
  const polarity = polarityEffects[base.yinYang]
  const cycleYears = sixtyYearCycle[animal]?.[element] || []

  return {
    animal: base.name,
    element: elementData.name,
    emoji: base.emoji,
    elementEmoji: elementData.emoji,
    
    // Layer 1: Base traits
    baseDescription: base.description,
    coreTraits: base.coreTraits,
    strengths: base.strengths,
    challenges: base.challenges,
    
    // Layer 2: Element enhancement
    elementDescription: elementData.description,
    elementEnhancement: elementData.enhancement[animal],
    elementQualities: elementData.coreQualities,
    
    // Layer 3: Yin/Yang polarity
    polarity: base.yinYang,
    polarityDescription: polarity.description,
    polarityQualities: polarity.qualities,
    
    // Cycle information
    cycleYears: cycleYears,
    nextOccurrence: cycleYears.find(y => y > new Date().getFullYear()),
    lastOccurrence: [...cycleYears].reverse().find(y => y < new Date().getFullYear()),
    
    // Compatibility
    compatibility: base.compatibility
  }
}
