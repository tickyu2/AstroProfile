{
  "name": "genesis-mcp-constitutional-data",
  "version": "1.0.0",
  "description": "GENESIS MCP Server - Constitutional Data Access for AI",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/test-server.js",
    "deploy": "gcloud run deploy genesis-mcp-server --source .",
    "setup-secrets": "node scripts/setup-secrets.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "genesis",
    "constitutional-ai",
    "bazi",
    "astrology"
  ],
  "author": "GENESIS Team",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/secret-manager": "^5.0.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "dotenv": "^16.3.1",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "config": {
    "notes": [
      "FIREBASE_PROJECT_ID - Your Firebase project ID",
      "GOOGLE_APPLICATION_CREDENTIALS - Path to service account JSON",
      "MCP_RATE_LIMIT - Requests per hour (default: 100)",
      "MCP_AUDIT_LOG - Enable audit logging (default: true)",
      "NODE_ENV - Environment (development|production)"
    ]
  }
}
