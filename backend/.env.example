# ═══════════════════════════════════════════════════════════════════════════════
# LUNA VOICE BACKEND - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────────────────────────────────────────
# GROQ API KEY (REQUIRED - powers both STT and LLM)
# ─────────────────────────────────────────────────────────────────────────────────
# Get free API key: https://console.groq.com
# One key powers everything:
#   - STT: Whisper Large v3 Turbo (~200ms transcription)
#   - LLM: Llama 3.3 70B (~300ms response)

GROQ_API_KEY=gsk_your_key_here

# ─────────────────────────────────────────────────────────────────────────────────
# GROQ MODEL OPTIONS (optional - defaults are recommended)
# ─────────────────────────────────────────────────────────────────────────────────

# LLM Model (for Luna's responses)
# Options (fastest to most capable):
#   - llama-3.3-70b-versatile (default, best quality)
#   - llama-4-scout-17b-16e-instruct (fastest)
#   - llama-3.1-8b-instant (very fast, good quality)
#   - mixtral-8x7b-32768 (good alternative)
GROQ_MODEL=llama-3.3-70b-versatile

# Whisper Model (for STT)
# Options:
#   - whisper-large-v3-turbo (default, fast + accurate)
#   - whisper-large-v3 (most accurate, slightly slower)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ─────────────────────────────────────────────────────────────────────────────────
# OLLAMA (Optional - Local LLM fallback when offline)
# ─────────────────────────────────────────────────────────────────────────────────
# Install: https://ollama.ai
# Start: ollama serve
# Pull model: ollama pull mistral

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ─────────────────────────────────────────────────────────────────────────────────
# ELEVENLABS TTS (Luna's voice output - emotion-aware)
# ─────────────────────────────────────────────────────────────────────────────────
# Get API key: https://elevenlabs.io/app/settings/api-keys
# Free tier: 10K characters/month

ELEVENLABS_API_KEY=sk_your_key_here

# Voice ID - Popular choices for Luna:
#   - 21m00Tcm4TlvDq8ikWAM (Rachel - warm, calm) [default]
#   - EXAVITQu4vr4xnSDxMaL (Bella - soft, gentle)
#   - XrExE9yKIg1WjnnlVkGX (Matilda - warm, friendly)
#   - XB0fDUnXU5powFXDhCwa (Charlotte - calm, seductive)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Model options:
#   - eleven_turbo_v2_5 (fastest, good for real-time)
#   - eleven_multilingual_v2 (best quality, emotional range)
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ─────────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────────

# WebSocket port (default: 8080)
VOICE_PORT=8080
