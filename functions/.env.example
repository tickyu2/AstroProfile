# ============================================
# GENESIS Cloud Functions (Node.js) Environment
# ============================================
# Copy this file to .env for local development
# For production, use Firebase Secrets Manager

# Neo4j AuraDB Configuration
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-auradb-password

# PostgreSQL (Cloud SQL / pgvector)
GENESIS_DB_USER=postgres
GENESIS_DB_PASSWORD=your-password
GENESIS_DB_NAME=genesis
GENESIS_DB_HOST=localhost
GENESIS_DB_PORT=5432
# Cloud SQL socket (for production):
# CLOUD_SQL_CONNECTION_NAME=your-project-id:us-central1:genesis-luna-db

# AI API Keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Admin
ADMIN_KEY=your-admin-key

# Environment
NODE_ENV=development
