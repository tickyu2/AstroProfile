# GENESIS Luna Database Configuration
# Copy this file to .env and fill in your values

# PostgreSQL Connection
GENESIS_DB_USER=postgres
GENESIS_DB_PASSWORD=your_strong_password_here
GENESIS_DB_NAME=genesis
GENESIS_DB_HOST=localhost
GENESIS_DB_PORT=5432

# Cloud SQL (for production deployment)
# Format: project-id:region:instance-name
CLOUD_SQL_CONNECTION_NAME=your-project-id:us-central1:genesis-luna-db

# SSL (set to true for external connections)
DB_SSL=false

# Environment
NODE_ENV=development
