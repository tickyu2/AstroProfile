# Environment variables - NEVER commit these!
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
functions/.env
functions/.env.*
!functions/.env.example

# Firebase/GCP Service Account Keys - NEVER commit these!
**/serviceAccountKey.json
**/serviceAccountKey*.json
**/*-firebase-adminsdk*.json
**/service-account*.json
**/credentials.json
**/*.pem
**/*.p12
# GCP project service account keys (e.g. astroprofile-391e6-*.json)
astroprofile-*.json

# Additional .env locations
backend/.env
mcp-server/.env
functions-python/.env

# Firebase local files
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebaserc

# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
nul

# Editor directories
.vscode/
.idea/

# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
functions-python/venv/
functions-python/__pycache__/
functions-python/**/__pycache__/
*storybook.log
storybook-static

# Claude Code agent worktrees (keep tracked .claude/ files like settings/docs)
.claude/worktrees/

# FreeFileSync local sync configs
*.ffs_batch.ffs_gui
*.ffs_gui
*.ffs_batch

# Local data dumps (regenerated on demand, not source of truth)
hybrid_organ_matrix.json
insertion_data.json
matrix_export.json

# Editor backup copies (e.g. "foo - Copy.ts.txt")
* - Copy.*
