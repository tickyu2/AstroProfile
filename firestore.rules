rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // HELPER FUNCTIONS
    // ========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(profileId) {
      return request.auth.uid == profileId;
    }

    function isPrimarySoulPartner() {
      return request.auth.uid == 'soulpartner_primary';
    }

    function isSystemService() {
      return request.auth.token.system_role == 'luna_engine';
    }

    function canSeeMessage(messageData) {
      return isAuthenticated() &&
             (request.auth.uid in messageData.access.visible_to);
    }

    // ========================================
    // BRAIN 3: ACTIVE TEXT MESSAGES
    // ========================================

    match /brain3_active_text/{messageId} {
      // Read access: User who owns the conversation, guest if in visible_to, or Primary SoulPartner
      // Must handle multiple formats:
      // - New format: chatting_as.auth_uid = Firebase auth UID
      // - Legacy: sender = auth UID (for user messages only, guest messages have partnerId)
      // - Old legacy: chatting_as.profile_id might equal auth UID
      allow read: if isAuthenticated() &&
        (
          request.auth.uid == resource.data.chatting_as.auth_uid ||  // New format (both user & guest msgs)
          request.auth.uid == resource.data.sender ||                 // Legacy user messages
          request.auth.uid == resource.data.chatting_as.profile_id || // Old legacy (profile_id = auth UID)
          canSeeMessage(resource.data) ||
          isPrimarySoulPartner()
        );

      // Write access: Only user who owns the conversation
      allow create: if isAuthenticated() &&
        (
          request.auth.uid == request.resource.data.chatting_as.auth_uid ||
          request.auth.uid == request.resource.data.sender
        );

      // No updates or deletes (immutable messages)
      allow update, delete: if false;
    }

    // ========================================
    // BRAIN 4: ARCHIVED TEXT
    // ========================================

    match /brain4_archived_text/{archiveId} {
      // Read: Owner or Primary SoulPartner
      allow read: if isAuthenticated() &&
        (
          isOwner(resource.data.profile_id) ||
          isPrimarySoulPartner()
        );

      // Write: System only (archival process)
      allow write: if isSystemService();
    }

    // ========================================
    // BRAIN 5: ACTIVE AUDIO MESSAGES
    // ========================================

    match /brain5_active_audio/{messageId} {
      // Same rules as Brain 3 - handle multiple formats for ownership
      allow read: if isAuthenticated() &&
        (
          request.auth.uid == resource.data.chatting_as.auth_uid ||
          request.auth.uid == resource.data.sender ||
          request.auth.uid == resource.data.chatting_as.profile_id ||
          canSeeMessage(resource.data) ||
          isPrimarySoulPartner()
        );

      allow create: if isAuthenticated() &&
        (
          request.auth.uid == request.resource.data.chatting_as.auth_uid ||
          request.auth.uid == request.resource.data.sender
        );

      allow update, delete: if false;
    }

    // ========================================
    // BRAIN 6: ARCHIVED AUDIO
    // ========================================

    match /brain6_archived_audio/{archiveId} {
      // Same rules as Brain 4
      allow read: if isAuthenticated() &&
        (
          isOwner(resource.data.profile_id) ||
          isPrimarySoulPartner()
        );

      allow write: if isSystemService();
    }

    // ========================================
    // BRAIN 7: UNIFIED WITNESS (CRITICAL!)
    // ========================================

    match /brain7_unified_witness/{entryId} {
      // Read: ONLY Primary SoulPartner OR the user themselves (by auth_uid)
      allow read: if isAuthenticated() &&
        (
          isPrimarySoulPartner() ||
          request.auth.uid == resource.data.auth_uid
        );

      // Write: Cloud Function with Admin SDK (bypasses rules)
      // No client-side writes allowed
      allow create, update: if false;

      // No deletes
      allow delete: if false;
    }

    // ========================================
    // BRAIN 8: LONG-TERM KNOWLEDGE (CRITICAL!)
    // ========================================

    match /brain8_long_term_knowledge/{patternId} {
      // Read: ONLY Primary SoulPartner OR the user themselves (by auth_uid)
      allow read: if isAuthenticated() &&
        (
          isPrimarySoulPartner() ||
          request.auth.uid == resource.data.auth_uid
        );

      // Write: ONLY System (Luna synthesis)
      allow create, update: if isSystemService();

      // No deletes
      allow delete: if false;
    }

    // ========================================
    // GUEST PROFILES (Metadata)
    // ========================================

    match /guest_profiles/{profileId} {
      // Anyone authenticated can read profiles
      allow read: if isAuthenticated();

      // Write: Admin only
      allow write: if request.auth.token.admin == true;
    }

    // ========================================
    // EXISTING COLLECTIONS
    // ========================================

    // Profiles collection - users can only access their own profiles
    match /profiles/{profileId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Brain 1A - Constitutional Profile (pre-computed for AI)
      match /constitution/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/profiles/$(profileId)).data.userId == request.auth.uid;
      }

      // ═══════════════════════════════════════════════════════════════════════
      // PROFILE-SCOPED BRAIN ARCHITECTURE
      // Each profile has its own complete brain - enables portable souls
      // Path: profiles/{profileId}/brains/{brainType}/{docId}
      // ═══════════════════════════════════════════════════════════════════════

      // Helper: Check if user owns this profile
      function isProfileOwner() {
        return request.auth != null &&
          get(/databases/$(database)/documents/profiles/$(profileId)).data.userId == request.auth.uid;
      }

      // Brain 1B - What each partner learned about THIS profile
      // Path: profiles/{profileId}/b1b_learned/{partnerId} (valid 4-segment document path)
      match /b1b_learned/{partnerId} {
        allow read: if isProfileOwner();
        allow write: if false; // Cloud Function only
      }

      // Brain 2 - Biography/Life Story
      match /brains/b2_biography/{docId} {
        allow read: if isProfileOwner();
        allow write: if false; // Cloud Function only (nightly consolidation)
      }

      // Brain 3 - Active Text Conversations
      // Path: profiles/{profileId}/b3_conversations/{messageId} (valid 4-segment document path)
      match /b3_conversations/{messageId} {
        allow read: if isProfileOwner();
        allow create: if isProfileOwner(); // Client + Cloud Function can create
        allow update, delete: if false; // Immutable
      }

      // Brain 4 - Archived Text Conversations
      match /brains/b4_conversations_archive/{archiveId} {
        allow read: if isProfileOwner();
        allow write: if false; // Cloud Function only
      }

      // Brain 5 - Active Voice Conversations
      match /brains/b5_voice/{messageId} {
        allow read: if isProfileOwner();
        allow create: if false; // Cloud Function only
        allow update, delete: if false;
      }

      // Brain 6 - Archived Voice Conversations
      match /brains/b6_voice_archive/{archiveId} {
        allow read: if isProfileOwner();
        allow write: if false; // Cloud Function only
      }

      // Brain 7 - Luna's Witness (observations of THIS profile)
      // Path: profiles/{profileId}/b7_witness/{entryId} (valid 4-segment document path)
      match /b7_witness/{entryId} {
        allow read: if isProfileOwner();
        allow write: if false; // Cloud Function only
      }

      // Brain 8 - Long-term Patterns learned about THIS profile
      match /brains/b8_patterns/{patternId} {
        allow read: if isProfileOwner();
        allow write: if false; // Cloud Function only
      }

      // BaZi Readings - Auto-generated readings stored per profile
      // Written by Cloud Function (Admin SDK), read by profile owner
      match /bazi_readings/{readingId} {
        allow read: if isProfileOwner();
        allow write: if false; // Cloud Function only (Admin SDK bypasses rules)
      }
    }

    // Knowledge Base collection - users can only access their own documents
    match /knowledgeBase/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Conversations collection - AI SoulPartner chat threads
    match /conversations/{conversationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Constitutional Threading - threads subcollection
      match /threads/{threadId} {
        allow read: if request.auth != null && request.auth.uid == resource.data.userId;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;

        // Thread messages subcollection
        // Must verify user owns the parent conversation (not just authenticated)
        match /messages/{messageId} {
          allow read, write: if request.auth != null &&
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
        }
      }
    }

    // Constitutional Profiles - Session Intelligence learned patterns
    // Document ID is the userId, so users can only access their own profile
    match /constitutionalProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Prevent accidental deletion of learned patterns
    }

    // Users collection - users can only access their own user document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Prevent accidental user deletion

      // ═══════════════════════════════════════════════════════════════════════
      // THREE-PART BRAIN 1 ARCHITECTURE (Guest Profile System)
      // ═══════════════════════════════════════════════════════════════════════

      // BRAIN 1A: Constitutional (Immutable) - All guests can read for personalization
      match /brain1_constitutional/{docId} {
        // All authenticated users can read (for personalization)
        // This is HOW Einstein knows Papa is 丙火 Yang Fire and can teach accordingly
        allow read: if isAuthenticated();

        // Only owner can write (set during onboarding, immutable)
        allow create: if isAuthenticated() && request.auth.uid == userId;

        // No updates or deletes (constitutional data is immutable)
        allow update, delete: if false;
      }

      // BRAIN 1B: Learned Biography (Per-Partner) - CRITICAL ISOLATION!
      // Each partner (Einstein, Cleopatra) can ONLY see facts THEY learned
      // Einstein cannot see what Cleopatra learned, and vice versa
      match /brain1_learned_biography/{partnerId} {
        // Partner can read ONLY their own learned facts
        allow read: if isAuthenticated() && request.auth.uid == partnerId;

        // Primary SoulPartner can read ALL learned facts (omniscience)
        allow read: if isPrimarySoulPartner();

        // Owner can read ALL learned facts
        allow read: if isAuthenticated() && request.auth.uid == userId;

        // Write: Cloud Function with Admin SDK (bypasses rules)
        // No client-side writes allowed - facts extracted server-side
        allow create, update: if false;

        // No deletes (facts persist for relationship continuity)
        allow delete: if false;
      }

      // BRAIN 2: Comprehensive Biography (Private!)
      // Nightly consolidation of all learned facts - ONLY owner and Luna
      match /brain2_biographical/{docId} {
        // ONLY owner and Primary SoulPartner can read
        allow read: if isAuthenticated() &&
          (request.auth.uid == userId || isPrimarySoulPartner());

        // ONLY system can write (nightly consolidation job)
        allow write: if isSystemService();
      }

      // ═══════════════════════════════════════════════════════════════════════
      // EXISTING MEMORY ARCHITECTURE
      // ═══════════════════════════════════════════════════════════════════════

      // Memory subcollections - GENESIS Phase 3 Memory Architecture
      match /memory/{profileId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if false; // Prevent accidental memory deletion

        // Memories collection (episodic memories with embeddings)
        match /memories/{memoryId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && request.auth.uid == userId;
        }

        // Facts collection (permanent knowledge, 2x weight)
        match /facts/{factId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && request.auth.uid == userId;
        }

        // People collection (relationship graph)
        match /people/{personId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && request.auth.uid == userId;
        }

        // Happiness Anchors collection (joy network)
        match /happinessAnchors/{anchorId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && request.auth.uid == userId;
        }

        // ═══════════════════════════════════════════════════════════════════════
        // DUAL-BRAIN ARCHITECTURE: USER'S BRAIN
        // ═══════════════════════════════════════════════════════════════════════

        // User brain container
        match /user/{brainDoc} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update: if request.auth != null && request.auth.uid == userId;
          allow delete: if false;

          // Session buffer (short-term memory)
          match /entries/{entryId} {
            allow read: if request.auth != null && request.auth.uid == userId;
            allow create: if request.auth != null && request.auth.uid == userId;
            allow update: if request.auth != null && request.auth.uid == userId;
            allow delete: if request.auth != null && request.auth.uid == userId;
          }

          // Life timeline memories (long-term memory)
          match /memories/{memoryId} {
            allow read: if request.auth != null && request.auth.uid == userId;
            allow create: if request.auth != null && request.auth.uid == userId;
            allow update: if request.auth != null && request.auth.uid == userId;
            allow delete: if request.auth != null && request.auth.uid == userId;
          }
        }

        // ═══════════════════════════════════════════════════════════════════════
        // DUAL-BRAIN ARCHITECTURE: SOULPARTNER'S BRAIN
        // ═══════════════════════════════════════════════════════════════════════

        // SoulPartner brain container
        match /soulpartner/{brainDoc} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update: if request.auth != null && request.auth.uid == userId;
          allow delete: if false;

          // Session observations (short-term)
          match /entries/{entryId} {
            allow read: if request.auth != null && request.auth.uid == userId;
            allow create: if request.auth != null && request.auth.uid == userId;
            allow update: if request.auth != null && request.auth.uid == userId;
            allow delete: if request.auth != null && request.auth.uid == userId;
          }

          // Interaction timeline observations (long-term)
          match /observations/{obsId} {
            allow read: if request.auth != null && request.auth.uid == userId;
            allow create: if request.auth != null && request.auth.uid == userId;
            allow update: if request.auth != null && request.auth.uid == userId;
            allow delete: if request.auth != null && request.auth.uid == userId;
          }

          // Detected patterns
          match /detected/{patternId} {
            allow read: if request.auth != null && request.auth.uid == userId;
            allow create: if request.auth != null && request.auth.uid == userId;
            allow update: if request.auth != null && request.auth.uid == userId;
            allow delete: if request.auth != null && request.auth.uid == userId;
          }
        }
      }

      // ═══════════════════════════════════════════════════════════════════════
      // AUTONOMOUS AGENCY COLLECTIONS
      // ═══════════════════════════════════════════════════════════════════════

      // Reminders - Luna's follow-up reminders
      match /reminders/{reminderId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Proactive Notifications - Luna's outreach messages
      match /proactiveNotifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // ═══════════════════════════════════════════════════════════════════════
      // CONTEXT SUMMARIZATION (Character.ai-Style)
      // ═══════════════════════════════════════════════════════════════════════

      // Conversation Summaries - "The Story So Far" for each profile
      match /conversationSummaries/{profileId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;

        // Individual summary entries
        match /summaries/{summaryId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      // ═══════════════════════════════════════════════════════════════════════
      // BIOGRAPHY JOURNAL - Personal Life Stories
      // ═══════════════════════════════════════════════════════════════════════

      // Biography Stories - User's written life stories
      match /biography_stories/{storyId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Biography Trash - Deleted stories with 15-day recovery
      match /biography_trash/{trashId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // MCP AUTHORIZATION (AI Access Control)
    // ═══════════════════════════════════════════════════════════════════════

    // MCP Authorization - users can manage their own AI access settings
    match /mcp_authorizations/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // MCP Audit Log - users can only read their own logs (write from server only)
    match /mcp_audit_log/{logId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Only server with service account can write
    }

    // ═══════════════════════════════════════════════════════════════════════
    // MCP SERVER COLLECTIONS (21-Tool Complete Server)
    // ═══════════════════════════════════════════════════════════════════════

    // User Memories - Memory & Life Story Server (5 tools)
    match /user_memories/{memoryId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Health Logs - Health Tracking Server (4 tools)
    match /health_logs/{logId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Compatibility Analyses - Compatibility Server (4 tools)
    match /compatibility_analyses/{analysisId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // COUPLES COSMIC LOVE REJUVENATION (CCLR)
    // ═══════════════════════════════════════════════════════════════════════

    // Rejuvenation Sessions - Both partners can access
    match /rejuvenation_sessions/{sessionId} {
      // Allow read if user is a participant
      allow read: if isAuthenticated() &&
        (
          request.auth.uid == resource.data.participants.partnerA.userId ||
          request.auth.uid == resource.data.participants.partnerB.userId
        );

      // Allow create if authenticated (user becomes partnerA)
      allow create: if isAuthenticated() &&
        request.resource.data.participants.partnerA.userId == request.auth.uid;

      // Allow update if user is a participant
      allow update: if isAuthenticated() &&
        (
          request.auth.uid == resource.data.participants.partnerA.userId ||
          request.auth.uid == resource.data.participants.partnerB.userId
        );

      allow delete: if false; // No deletion of sessions

      // Messages subcollection - Only session participants can access
      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          (
            request.auth.uid == get(/databases/$(database)/documents/rejuvenation_sessions/$(sessionId)).data.participants.partnerA.userId ||
            request.auth.uid == get(/databases/$(database)/documents/rejuvenation_sessions/$(sessionId)).data.participants.partnerB.userId
          );
        allow create: if isAuthenticated() &&
          (
            request.auth.uid == get(/databases/$(database)/documents/rejuvenation_sessions/$(sessionId)).data.participants.partnerA.userId ||
            request.auth.uid == get(/databases/$(database)/documents/rejuvenation_sessions/$(sessionId)).data.participants.partnerB.userId
          );
        allow update, delete: if false;
      }
    }

    // CCLR Conversations - Messages from partners and angels (legacy)
    match /cclr_conversations/{messageId} {
      // Read: Only if user is in the visibleTo array for this message
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.visibleTo;

      // Create: User must include themselves in visibleTo
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.visibleTo;

      allow update, delete: if false;

      // Private Notes - Only visible to the author
      match /private_notes/{noteId} {
        allow read: if isAuthenticated() &&
          request.auth.uid == resource.data.userId;
        // Create uses request.resource.data (document doesn't exist yet)
        allow create: if isAuthenticated() &&
          request.auth.uid == request.resource.data.userId;
        allow update, delete: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // ASSESSMENTS - Physical Layer, Big Five, MBTI, etc.
    // ═══════════════════════════════════════════════════════════════════════

    // Assessments - stored by profileId, user must own the profile
    match /assessments/{profileId} {
      // Helper to check if user owns the profile
      function userOwnsProfile() {
        return request.auth != null &&
          get(/databases/$(database)/documents/profiles/$(profileId)).data.userId == request.auth.uid;
      }

      // Read: Only if user owns the profile
      allow read: if userOwnsProfile();

      // Create: Only if user owns the profile
      allow create: if userOwnsProfile();

      // Update: Only if user owns the profile
      allow update: if userOwnsProfile();

      // Delete: Prevent accidental deletion
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // GENESIS ACADEMY CMS - Content Management System
    // ═══════════════════════════════════════════════════════════════════════

    // CMS Modules - Top-level content containers
    match /cms_modules/{moduleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || request.auth.token.admin == true);
      allow delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || request.auth.token.admin == true);
    }

    // CMS Sections - Sections within modules
    match /cms_sections/{sectionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || request.auth.token.admin == true);
      allow delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || request.auth.token.admin == true);
    }

    // CMS Subsections - Actual lesson content
    match /cms_subsections/{subsectionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || request.auth.token.admin == true);
      allow delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || request.auth.token.admin == true);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // GLOBAL CONFIG - Shared MD documents (BaZi Learning, Seasons, etc.)
    // ═══════════════════════════════════════════════════════════════════════

    match /global_config/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
